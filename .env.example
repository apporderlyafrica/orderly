# Copie ce fichier en `.env` et remplis les valeurs de ton projet Supabase.
# (Le fichier `.env` est ignoré par Git — les secrets ne doivent pas être commités.)

# Projet Supabase
VITE_SUPABASE_URL="https://VOTRE_PROJET.supabase.co"
VITE_SUPABASE_PROJECT_ID="votre-projet-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Aliases serveur (utilisés aussi côté client si besoin)
SUPABASE_URL="${VITE_SUPABASE_URL}"
SUPABASE_PROJECT_ID="${VITE_SUPABASE_PROJECT_ID}"
SUPABASE_PUBLISHABLE_KEY="${VITE_SUPABASE_PUBLISHABLE_KEY}"
